# MllyMed deploy muhit o'zgaruvchilari — namunaviy nusxa.
# Haqiqiy fayl: deploy/.env  (gitignore'da — HECH QACHON commit qilmang!)
# Bot faqat shu tokenni o'qiydi (kodda default YO'Q).

# BotFather → /revoke bilan eski tokenни bekor qiling, YANGI tokenни shu yerga yozing
TELEGRAM_BOT_TOKEN=

# Ixtiyoriy: Mini App (Web App) URL. Default: https://mllymed.onrender.com
# WEBAPP_URL=https://mllymed.onrender.com

# Ixtiyoriy: konteyner portlari (Render PORT ni o'zi beradi — o'zgartirmang)
# PUBLIC_PORT=8200
# INTERNAL_PORT=9000
