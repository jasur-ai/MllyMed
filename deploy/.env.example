# MllyMed deploy muhit o'zgaruvchilari — namunaviy nusxa.
# Haqiqiy fayl: deploy/.env  (gitignore'da — HECH QACHON commit qilmang!)

# BotFather bergan token (t.me/BotFather → /newbot yoki /token)
TELEGRAM_BOT_TOKEN=

# MllyMed HTTP API manzili (bot shu yerga ulanadi)
#   lokal:  http://127.0.0.1:8200
#   deploy: https://mllymed.uz   (yoki http://127.0.0.1:8200 — bitta serverda)
MLLYMED_API=http://127.0.0.1:8200

# Konteyner portlari (odatda o'zgartirilmaydi)
# INTERNAL_PORT=9000
# PUBLIC_PORT=8200
